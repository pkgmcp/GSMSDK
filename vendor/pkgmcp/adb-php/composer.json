{
    "name": "pkgmcp/adb-php",
    "description": "Pure PHP 8.3 ADB client — full port of @devicefarmer/adbkit v3.3.8",
    "type": "library",
    "version": "1.0.0",
    "license": "Apache-2.0",
    "keywords": ["android", "adb", "adbkit", "debug", "shell", "logcat", "apk", "install"],
    "homepage": "https://github.com/pkgmcp/adb-php",
    "authors": [
        {
            "name": "shamimstack",
            "email": "shamimstack@gmail.com",
            "homepage": "https://github.com/pkgmcp",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AdbPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdbPhp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
