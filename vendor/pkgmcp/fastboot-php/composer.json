{
    "name": "pkgmcp/fastboot-php",
    "description": "PHP 8.3 implementation of the Android Fastboot protocol — full port of fastboot.js",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": ["android", "fastboot", "usb", "bootloader", "flash", "sparse"],
    "homepage": "https://github.com/pkgmcp/fastboot-php",
    "authors": [
        {
            "name": "shamimstack",
            "email": "shamimstack@gmail.com",
            "homepage": "https://github.com/pkgmcp",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FastbootPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FastbootPhp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    }
}
