{
    "name": "pkgmcp/gsmsdk",
    "type": "library",
    "description": "GSMSDK - Full-Stack PHP 8.5+ Framework for Desktop & Mobile Applications",
    "keywords": ["php", "framework", "fullstack", "desktop", "mobile", "sdk", "gsm"],
    "homepage": "https://github.com/pkgmcp/gsmsdk",
    "authors": [
        {
            "name": "GSMSDK Team",
            "email": "dev@gsmsdk.io",
            "homepage": "https://gsmsdk.io"
        }
    ],
    "require": {
        "php": ">=8.5.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "pkgmcp/adb-php": "^1.0",
        "pkgmcp/fastboot-php": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GSMSDK\\": "src/",
            "GSMSDK\\Core\\": "src/Core/",
            "GSMSDK\\HTTP\\": "src/HTTP/",
            "GSMSDK\\Database\\": "src/Database/",
            "GSMSDK\\CLI\\": "src/CLI/",
            "GSMSDK\\Desktop\\": "src/Desktop/",
            "GSMSDK\\Mobile\\": "src/Mobile/",
            "GSMSDK\\Fastboot\\": "src/Fastboot/",
            "GSMSDK\\ADB\\": "src/ADB/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GSMSDK\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
